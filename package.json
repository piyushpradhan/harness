{
  "name": "harness",
  "version": "0.1.0",
  "description": "Minimal Electron harness",
  "private": true,
  "packageManager": "bun@1.3.14",
  "main": "main.js",
  "scripts": {
    "postinstall": "node -e \"require('fs').existsSync('node_modules/electron/dist/version') || require('child_process').spawnSync(process.execPath, ['node_modules/electron/install.js'], {stdio: 'inherit'})\"",
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "electron": "^44.1.1",
    "electron-reloader": "^1.2.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "trustedDependencies": [
    "electron"
  ]
}
