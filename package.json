{
  "name": "harness",
  "version": "0.1.0",
  "description": "Minimal Electron harness",
  "private": true,
  "packageManager": "bun@1.3.14",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node -e \"require('fs').existsSync('node_modules/electron/dist/version') || require('child_process').spawnSync(process.execPath, ['node_modules/electron/install.js'], {stdio: 'inherit'})\"",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "bun scripts/bench.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.1.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "lucide-react": "^1.41.0",
    "prettier": "^3.9.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "trustedDependencies": [
    "electron"
  ],
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@shadcn/react": "^0.3.1",
    "cn": "^0.3.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
